#!/usr/bin/env python3
import os
import sys
from pathlib import Path
import subprocess
import shutil

BASE_DIR = Path(__file__).parent.parent
sys.path.append(str(BASE_DIR / "scripts"))
 
try:
    import jdk
    import jre
except ImportError as e:
    sys.exit(1)

def main():
    if len(sys.argv) < 3:
        sys.exit(1)
        
    layers_dir = Path(sys.argv[1])
    version = "21" 

    jvm_type = os.getenv("BP_JVM_TYPE", "JRE").upper()
    is_jdk_mode = (jvm_type == "JDK")

    if is_jdk_mode:
        if not jdk.install_jdk(layers_dir, version, launch=True):
            sys.exit(1)
    else:
        if not jdk.install_jdk(layers_dir, version, launch=False):
            sys.exit(1)
        if not jre.install_jre_fips(layers_dir, version, is_jdk_mode=False):
            sys.exit(1)

    runtime_layer_name = "jdk" if is_jdk_mode else "jre"
    active_layer_path = layers_dir / runtime_layer_name
    
    exec_d_path = active_layer_path / "exec.d"
    exec_d_path.mkdir(parents=True, exist_ok=True)
    
    binary_dest = exec_d_path / "java-memory-calculator"
    
    if not binary_dest.exists():
        calc_src = BASE_DIR / "bin" / "java-memory-calculator"
        subprocess.run(["pyinstaller", "--onefile", str(calc_src)], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        shutil.copy("dist/java-memory-calculator", str(binary_dest))
        os.chmod(str(binary_dest), 0o755)
        shutil.rmtree("build", ignore_errors=True)
        shutil.rmtree("dist", ignore_errors=True)
        for f in os.listdir("."):
            if f.endswith(".spec"): os.remove(f)

    java_bin = str(active_layer_path / "bin" / "java")
    launch_toml = layers_dir / "launch.toml"
    
    processes_content = f"""

[[processes]]
type = "check-java"
command = ["{java_bin}"]
args = ["-version"]

[[processes]]
type = "heap-info"
command = ["{java_bin}"]
args = ["-XshowSettings:vm", "-version"]
"""
    
    with open(launch_toml, "w") as f:
        f.write(processes_content)

    sys.exit(0)

if __name__ == "__main__":
    main()